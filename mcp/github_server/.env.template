# GitHub MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required)
# Get this from: https://github.com/settings/tokens
# Required scopes: repo, workflow (for GitHub Actions access)
GITHUB_TOKEN=your_github_token_here

# GitHub App Configuration (optional, for enhanced permissions)
# Only needed if you're using GitHub Apps instead of Personal Access Tokens
# If using GitHub Apps, you'll need to create a GitHub App and get these values
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_here

# GCP Configuration (optional, will use gcloud config defaults if not set)
# These values will be automatically detected from gcloud config if not specified
PROJECT_ID=your_gcp_project_id_here
REGION=asia-northeast1
SERVICE_NAME=github-mcp-server
